* text eol=crlf

# Text files defaults
* text=auto

# Line endings for scripts
*.sh text eol=lf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.fbx binary

# Unity assets
# Force Git LFS or binary for Unity asset files
*.unity   binary
*.prefab  binary
*.mat     binary
*.fbx     binary
*.anim    binary
*.controller binary

# Prevent diff on lock and cert files
*.lock merge=union
*.pem binary